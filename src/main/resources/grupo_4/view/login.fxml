<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER_LEFT" prefHeight="520" prefWidth="460" spacing="14" styleClass="page" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grupo_4.clientes.controller.LoginController">
    <padding><Insets bottom="32" left="36" right="36" top="32" /></padding>
    <ImageView fitHeight="70.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../Image/UAMLOGO.png" />
        </image>
    </ImageView>
    <Label styleClass="eyebrow" text="GESTIÓN DE CLIENTES" />
    <Label styleClass="title" text="Iniciar sesión" />
    <Label text="Usuario" />
    <TextField fx:id="txtUsuario" onKeyPressed="#manejarTecla" promptText="Escribe tu usuario" />
    <Label text="Contraseña" />
    <PasswordField fx:id="txtClave" onKeyPressed="#manejarTecla" promptText="Escribe tu contraseña" />
    <HBox spacing="10">
        <Button onAction="#iniciarSesion" styleClass="primary" text="Iniciar sesión" />
        <Button onAction="#salir" text="Salir" />
    </HBox>
    <Label styleClass="muted" text="Acceso de demostración: admin / 1234" />
</VBox>
