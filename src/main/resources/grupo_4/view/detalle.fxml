<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="grupo_4.clientes.controller.DetalleController"
      spacing="18" prefWidth="730" prefHeight="550"
      stylesheets="@../css/estilos.css" styleClass="page">
    <padding><Insets top="26" right="30" bottom="26" left="30"/></padding>
    <Label text="Detalle del cliente" styleClass="eyebrow"/>
    <Label fx:id="lblNombre" text="Nombre completo" wrapText="true" styleClass="title"/>
    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <GridPane hgap="20" vgap="16">
                <Label text="Tipo de cliente" GridPane.rowIndex="0"/>
                <Label fx:id="lblTipo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Ciudad" GridPane.rowIndex="1"/>
                <Label fx:id="lblCiudad" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Nacimiento" GridPane.rowIndex="2"/>
                <Label fx:id="lblNacimiento" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Solicitud" GridPane.rowIndex="3"/>
                <Label fx:id="lblSolicitud" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <Label text="Servicios de interés" styleClass="section-title"/>
            <ListView fx:id="listaServicios" prefHeight="125" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="12" prefWidth="200" minWidth="200" maxWidth="200" alignment="TOP_CENTER">
            <StackPane prefHeight="210" styleClass="photo-box">
                <ImageView fx:id="imgFoto" fitWidth="180" fitHeight="200" preserveRatio="true"/>
            </StackPane>
            <Label fx:id="lblFoto" text="Sin fotografía" wrapText="true" styleClass="muted"/>
        </VBox>
    </HBox>
    <Button text="Volver" onAction="#volver" styleClass="primary"/>
</VBox>
